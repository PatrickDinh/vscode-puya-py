{
  "name": "algorand-typescript-vscode",
  "displayName": "Algorand TypeScript",
  "version": "0.1.0",
  "private": true,
  "description": "Tooling to support building with Algorand TypeScript",
  "author": "Algorand Foundation",
  "publisher": "AlgorandFoundation",
  "license": "MIT",
  "keywords": [
    "algokit",
    "algorand",
    "avm",
    "algorand typescript",
    "typescript",
    "algokit algorand typescript",
    "puya",
    "puya-ts",
    "puyats",
    "algorand smart contracts"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "icon": "images/icon.png",
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/algorandfoundation/algokit-languages-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/algorandfoundation/algokit-languages-vscode/issues"
  },
  "scripts": {
    "lint": "eslint src -c ../common/eslint.config.mjs",
    "lint:fix": "npm run lint -- --fix",
    "audit": "better-npm-audit audit -l moderate",
    "build": "npm run build:prod",
    "build:clean": "rimraf dist",
    "build:check-types": "tsc --noEmit",
    "build:dev": "run-s build:clean build:check-types && node ../common/esbuild.mjs",
    "build:prod": "run-s build:clean build:check-types && node ../common/esbuild.mjs --production",
    "pretest": "run-s pretest:*",
    "pretest:build-extension": "npm run build:dev",
    "pretest:clean": "rimraf out",
    "pretest:setup-workspace": "cd ./src/test/workspace && npm install && cd ../../../",
    "pretest:build-tests": "tsc -p tsconfig.test.json --outDir out && tsc-alias --outDir out",
    "test": "cross-env CODE_TESTS_WORKSPACE=\"src/test/workspace\" node \"out/typescript/src/test/index\"",
    "create-release": "semantic-release-monorepo",
    "pre-commit": "run-s build:check-types lint:fix audit test",
    "package": "vsce package"
  },
  "dependencies": {},
  "devDependencies": {},
  "main": "dist/extension.js",
  "activationEvents": [
    "onLanguage:typescript",
    "onCommand:extension.algorandTypeScript.languageServer.restart"
  ],
  "workspaceTrust": {
    "request": "never"
  },
  "contributes": {
    "commands": [
      {
        "command": "algorandTypeScript.languageServer.restart",
        "title": "Restart Server",
        "category": "Algorand TypeScript"
      }
    ],
    "configuration": {
      "title": "Algorand TypeScript",
      "properties": {
        "algorandTypeScript.languageServer.enable": {
          "scope": "window",
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Controls if the language server should be enabled."
        }
      }
    }
  }
}